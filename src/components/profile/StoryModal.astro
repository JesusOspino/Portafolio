---
import { Icon } from "astro-icon/components";
import { profile } from "../../data/profile";
import type { highlights as HighlightsType } from "../../data/highlights";

interface Props {
  highlights: typeof HighlightsType;
}

const { highlights } = Astro.props;
---

<div
  id="story-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-0 sm:p-6"
>
  <div
    class="relative flex h-full w-full max-w-md flex-col overflow-hidden bg-neutral-900 sm:h-[85vh] sm:rounded-2xl"
  >
    <div class="absolute inset-x-0 top-0 z-10 flex gap-1.5 p-3">
      {
        highlights.map((_, index) => (
          <div
            data-story-track
            data-index={index}
            class="h-0.5 flex-1 overflow-hidden rounded-full bg-white/30"
          >
            <div data-story-fill class="h-full w-0 bg-white" />
          </div>
        ))
      }
    </div>

    <div
      class="absolute inset-x-0 top-6 z-10 flex items-center gap-2.5 px-3 pt-2"
    >
      <img
        src={profile.avatar}
        alt={profile.name}
        class="size-8 rounded-full object-cover ring-2 ring-white/80"
      />
      <span data-story-label class="text-sm font-semibold text-white" />
      <button
        id="story-modal-close"
        type="button"
        aria-label="Cerrar"
        class="ml-auto grid size-8 cursor-pointer place-items-center rounded-full text-white/90 transition hover:bg-white/10"
      >
        <Icon name="close" class="size-5" />
      </button>
    </div>

    <div class="relative flex flex-1 items-center justify-center px-8">
      {
        highlights.map((item, index) => (
          <div
            data-story-slide={index}
            class="hidden flex-col items-center gap-5 text-center"
          >
            <div class="grid size-20 place-items-center rounded-full bg-gradient-to-br from-primary to-secondary p-[3px]">
              <div class="grid size-full place-items-center rounded-full bg-neutral-900">
                <Icon name={item.icon} class="size-9 text-secondary" />
              </div>
            </div>
            <h2 class="text-xl font-semibold text-white">{item.label}</h2>
            <p class="text-sm leading-relaxed text-neutral-300">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>

    <button
      type="button"
      data-story-prev
      aria-label="Anterior"
      class="absolute inset-y-0 left-0 z-[5] w-1/3 cursor-pointer"
    />
    <button
      type="button"
      data-story-next
      aria-label="Siguiente"
      class="absolute inset-y-0 right-0 z-[5] w-2/3 cursor-pointer"
    />
  </div>
</div>

<script is:inline define:vars={{ total: highlights.length, labels: highlights.map((h) => h.label) }}>
  const SLIDE_DURATION = 4500;

  const modal = document.getElementById("story-modal");
  const closeButton = document.getElementById("story-modal-close");
  const tracks = document.querySelectorAll("[data-story-track]");
  const fills = document.querySelectorAll("[data-story-fill]");
  const slides = document.querySelectorAll("[data-story-slide]");
  const label = document.querySelector("[data-story-label]");
  const prevZone = document.querySelector("[data-story-prev]");
  const nextZone = document.querySelector("[data-story-next]");

  let current = 0;
  let timer;

  function clearTimer() {
    if (timer) {
      clearTimeout(timer);
      timer = undefined;
    }
  }

  function setFill(index, state) {
    const fill = fills[index];
    if (!fill) return;
    fill.style.transition = "none";
    fill.style.width = state === "done" ? "100%" : "0%";
    if (state === "active") {
      requestAnimationFrame(() => {
        fill.style.transition = `width ${SLIDE_DURATION}ms linear`;
        fill.style.width = "100%";
      });
    }
  }

  function render() {
    slides.forEach((slide) => {
      slide.classList.toggle(
        "flex",
        Number(slide.dataset.storySlide) === current,
      );
      slide.classList.toggle(
        "hidden",
        Number(slide.dataset.storySlide) !== current,
      );
    });
    tracks.forEach((_, index) => {
      setFill(index, index < current ? "done" : index === current ? "active" : "idle");
    });
    if (label) label.textContent = labels[current] ?? "";
  }

  function goTo(index) {
    clearTimer();
    if (index >= total) {
      close();
      return;
    }
    current = Math.max(0, index);
    render();
    timer = setTimeout(() => goTo(current + 1), SLIDE_DURATION);
  }

  function open(startIndex) {
    current = startIndex;
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    document.body.classList.add("overflow-hidden");
    render();
    clearTimer();
    timer = setTimeout(() => goTo(current + 1), SLIDE_DURATION);
  }

  function close() {
    clearTimer();
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    document.body.classList.remove("overflow-hidden");
  }

  document.querySelectorAll("[data-open-story]").forEach((button) => {
    button.addEventListener("click", () => {
      const index = Number(button.dataset.openStory ?? 0);
      open(index);
    });
  });

  closeButton?.addEventListener("click", close);
  prevZone?.addEventListener("click", () => goTo(current - 1));
  nextZone?.addEventListener("click", () => goTo(current + 1));
  document.addEventListener("keydown", (event) => {
    if (!modal || modal.classList.contains("hidden")) return;
    if (event.key === "Escape") close();
    if (event.key === "ArrowLeft") goTo(current - 1);
    if (event.key === "ArrowRight") goTo(current + 1);
  });
</script>
