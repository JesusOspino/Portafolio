---
import { Icon } from "astro-icon/components";
import { highlights } from "../../data/highlights";
import StoryModal from "./StoryModal.astro";
---

<section class="mx-auto max-w-5xl px-4 py-6">
  <ul class="no-scrollbar flex gap-5 overflow-x-auto">
    {
      highlights.map((item, index) => (
        <li class="flex shrink-0 flex-col items-center gap-2">
          <button
            type="button"
            data-open-story={index}
            aria-label={`Ver historia: ${item.label}`}
            class="grid size-16 cursor-pointer place-items-center rounded-full bg-gradient-to-br from-primary to-secondary p-[2px] transition hover:scale-105 hover:opacity-90 sm:size-20"
          >
            <div class="grid size-full place-items-center rounded-full bg-white dark:bg-black">
              <Icon
                name={item.icon}
                class="size-6 text-primary dark:text-secondary sm:size-7"
              />
            </div>
          </button>
          <span class="max-w-16 truncate text-xs text-neutral-600 dark:text-neutral-300">
            {item.label}
          </span>
        </li>
      ))
    }
  </ul>
</section>

<StoryModal highlights={highlights} />
