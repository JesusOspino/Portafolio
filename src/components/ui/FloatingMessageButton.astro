---
import { Icon } from "astro-icon/components";
import { profile } from "../../data/profile";
---

<a
  href={profile.contactEmail}
  aria-label="Enviar mensaje"
  class="fixed bottom-20 left-4 z-40 grid size-12 place-items-center rounded-full bg-primary text-white shadow-lg transition hover:opacity-90 sm:bottom-6"
>
  <Icon name="send" class="size-5" />
</a>
